---
// Placeholder videos/images for the cinematic hero section. 
// In production, this would use a high-res video of Santorini/Baghdad skyline.
const heroImage = "https://scraper.places.sumerai.tech/api/v1/place-image?ref=places%2FChIJH4DmFAB_VxUR0ZQVmD-Yk5c%2Fphotos%2FAa-ngMY2LjpKR5Lsy191JipgGKdIXbEuslCnWjgMjfu8-k6xJu48Jh4mR80i_XsePS0_6JIwSLcZnzVQUoZPGLp8SnVfCElOLG1LN9tjXkj-aGdMxI9ciiaGgUQaS2ipq_f9-8dqZs67pa94IWLbgJNcATjEDz2T5CJEwSwP26IZKbCyVJ5vhOgCN1QYfvLIoRK78Tllln56Xi-yNY3NkKeTXEqQ0W3p74toDMP0oQJ1U7LDEEhG80mOhkW2Ni9XJ_CSz8lgqHVpLajXJaoXKOfyFsJDRNf5ap93vxOc7QpIxQHr3fPImUNpeIKtNLMEws5sF3nqjKjapryusV-R-KMjQiAHKu3XE6mUJB9rRW_vvXoW2kardWrxkTIbEADXW7LrtyO6zkTBNXQNZ3F3qYrflzDPR9zCrz99iQVkdYTaYVfQYw";
---

<section class="relative h-screen min-h-[800px] w-full flex items-center justify-center overflow-hidden bg-aegean-deep">
	<!-- Ambient Parallax Background -->
	<div class="absolute inset-0 z-0">
		<div class="absolute inset-0 bg-gradient-to-b from-aegean-deep/80 via-aegean-deep/40 to-aegean-deep z-10"></div>
		<img 
			src={heroImage} 
			alt="Santorini Rooftop View over Baghdad" 
			class="w-full h-full object-cover opacity-80 gpu-accelerated scale-105 hover:scale-100 transition-transform duration-[20s] ease-out"
			fetchpriority="high"
		/>
	</div>

	<!-- Content Container -->
	<div class="relative z-20 text-center px-6 max-w-5xl mx-auto mt-20">
		<!-- Live Status & Ratings Pill -->
		<div class="flex flex-col md:flex-row items-center justify-center gap-4 mb-8 animate-fade-in" style="animation-delay: 0.2s;">
			<div class="flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-4 py-1.5 rounded-full">
				<span class="relative flex h-2.5 w-2.5">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
				</span>
				<span class="text-xs font-sans text-white tracking-wider uppercase">Open now &middot; until 1:00 AM</span>
			</div>
			<div class="flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-4 py-1.5 rounded-full">
				<div class="flex text-gold-accent">
					★ ★ ★ ★ <span class="text-white/50">★</span>
				</div>
				<span class="text-xs font-sans text-white font-medium">4.5 on Google</span>
			</div>
		</div>

		<!-- Bilingual Typography -->
		<h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-caldera-white leading-tight mb-4 animate-slide-up gpu-accelerated" style="animation-delay: 0.4s;">
			A Few Steps To Greece
		</h1>
		<p class="font-sans text-2xl md:text-4xl text-gold-accent font-light mb-10 animate-slide-up gpu-accelerated" dir="rtl" style="animation-delay: 0.6s;">
			مطعــم سانتوريــني
		</p>

		<!-- Dual CTAs -->
		<div class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in" style="animation-delay: 0.8s;">
			<a href="#reservations" class="w-full sm:w-auto px-8 py-4 bg-terracotta hover:bg-[#a94a28] text-white font-sans font-medium text-sm uppercase tracking-widest rounded-full transition-all duration-300 shadow-[0_0_20px_rgba(200,90,50,0.4)] hover:scale-105 active:scale-95 gpu-accelerated">
				Reserve a Table
			</a>
			<a href="#menu" class="w-full sm:w-auto px-8 py-4 bg-transparent border border-white/40 hover:bg-white/10 text-white font-sans font-medium text-sm uppercase tracking-widest rounded-full transition-all duration-300 hover:scale-105 active:scale-95 gpu-accelerated">
				Explore Menu
			</a>
		</div>
	</div>

	<!-- Scroll Indicator -->
	<div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 animate-bounce opacity-70">
		<span class="text-[10px] font-sans uppercase tracking-widest text-white">Scroll</span>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
	</div>
</section>