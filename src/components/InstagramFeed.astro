// Format number
const formatNumber = (num: number) => num.toLocaleString('en-US');
---

<section id="gallery" class="py-24 bg-caldera-white relative overflow-hidden arch-mask pb-32">
	<!-- Decorative bg -->
	<div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/white-wall.png')] opacity-50 mix-blend-multiply pointer-events-none"></div>

	<div class="max-w-7xl mx-auto px-6 relative z-10">
		
		<!-- Header -->
		<div class="flex flex-col md:flex-row justify-between items-end mb-12 reveal gap-6">
			<div>
				<h2 class="font-serif text-4xl md:text-5xl text-aegean-deep mb-2">Visual Escape</h2>
				<p class="font-sans text-aegean-deep/60 max-w-md">Follow our journey on Instagram for a glimpse into our Aegean atmosphere and culinary creations.</p>
			</div>
			
			<a href={`https://instagram.com/${username}`} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 bg-white px-5 py-3 rounded-full shadow-lg hover:shadow-xl transition-all gpu-accelerated">
				<img src={profile_pic} alt={username} class="w-10 h-10 rounded-full object-cover border border-gray-200" />
				<div>
					<p class="font-sans text-sm font-bold text-aegean-deep group-hover:text-terracotta transition-colors">@{username}</p>
					<p class="font-sans text-xs text-aegean-deep/60">{formatNumber(followers_count)} Followers</p>
				</div>
			</a>
		</div>

		<!-- Instagram Grid -->
		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 staggered-reveal">
			{posts.map((post) => (
				<a href={`https://instagram.com/${username}`} target="_blank" class="tilt-card relative group block aspect-square rounded-2xl overflow-hidden shadow-md gpu-accelerated bg-white">
					<img src={post.image_url} alt="Instagram post" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out" loading="lazy" />
					
					<!-- Hover Overlay -->
					<div class="absolute inset-0 bg-aegean-deep/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col p-6 justify-between backdrop-blur-sm">
						<!-- Likes -->
						<div class="flex justify-end">
							<span class="flex items-center gap-1.5 text-white font-sans text-sm font-semibold">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
								{post.likes}
							</span>
						</div>
						
						<!-- Caption Preview -->
						<p class="text-white text-xs font-sans line-clamp-4 leading-relaxed" dir="auto">
							{post.caption}
						</p>
					</div>
				</a>
			))}
		</div>
		
	</div>
</section>

<style>
	/* Ensure clip path scales gracefully on mobile */
	@media (max-width: 768px) {
		.arch-mask {
			clip-path: path('M0,50 C0,22.38 22.38,0 50,0 C77.62,0 100,22.38 100,50 L100,600 L0,600 Z');
		}
	}
</style>