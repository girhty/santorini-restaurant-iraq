---

<section id="menu" class="relative overflow-hidden bg-deepsea py-24 text-cream sm:py-28 lg:py-36">
  <!-- Sculptural background layers -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-40 top-10 h-[30rem] w-[30rem] rounded-full border border-white/8"></div>
    <div class="absolute -right-24 bottom-0 h-[26rem] w-[26rem] rounded-t-full border border-gold/12"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_10%,rgba(217,164,65,0.18),transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_88%_82%,rgba(46,134,171,0.22),transparent_58%)]"></div>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">
    <!-- ============ HEADER ============ -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="flex items-center gap-3 text-[0.66rem] uppercase tracking-luxe text-gold" data-reveal>
          <span class="h-px w-12 bg-gold" aria-hidden="true"></span>
          The Menu
        </p>
        <h2 class="mt-7 max-w-3xl font-display text-[clamp(2.5rem,6.2vw,5.15rem)] leading-[0.95]" data-reveal="left">
          Greek plates,
          <span class="block italic text-gold">crafted with restraint.</span>
        </h2>
      </div>
      <p class="max-w-md text-cream/72 leading-relaxed" data-reveal="right">
        From the charcoal grill to the pastry kitchen — every dish is composed around Mediterranean produce, Aegean
        herbs and the slow rhythm of island dining.
        <span class="mt-4 block font-arabic text-cream/62" dir="rtl" lang="ar">
          نكهات يونانية أصيلة تُقدَّم بذوق يليق بتجربة استثنائية.
        </span>
      </p>
    </div>

    <!-- ============ TABS (liquid morphing indicator) ============ -->
    <div class="mt-12 overflow-x-auto pb-2" data-reveal>
      <div
        class="relative inline-flex min-w-max items-center gap-1.5 rounded-full border border-white/12 bg-white/[0.06] p-1.5"
        role="tablist"
        aria-label="Menu categories"
        id="menuTabs"
      >
        <span class="tab-indicator" id="tabIndicator" aria-hidden="true"></span>
        {
          categories.map((cat, i) => (
            <button
              type="button"
              class="tab-btn rounded-full px-6 text-[0.72rem] font-semibold uppercase tracking-wide2 text-cream/72 sm:px-7"
              role="tab"
              id={`tab-${cat.id}`}
              aria-controls={`panel-${cat.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={cat.id}
            >
              {cat.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- ============ PANELS ============ -->
    {
      categories.map((cat, i) => (
        <div
          class:list={['menu-panel mt-12 gap-7 sm:grid-cols-2 lg:grid-cols-3', i === 0 && 'is-active']}
          id={`panel-${cat.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${cat.id}`}
          data-panel={cat.id}
          tabindex="0"
        >
          {cat.items.map((item, idx) => (
            <article
              class="group relative overflow-hidden rounded-[1.5rem] border border-white/10 bg-white/[0.055] p-7 backdrop-blur-md transition-all duration-700 hover:-translate-y-2 hover:border-gold/45 hover:bg-white/[0.1]"
              data-tilt="7"
              data-reveal="flip"
              style={`transition-delay:${idx * 90}ms`}
            >
              <div class="flex items-start justify-between gap-5">
                <div>
                  {item.tag && (
                    <span class="inline-flex items-center rounded-full bg-gold/18 px-3.5 py-1.5 text-[0.58rem] font-semibold uppercase tracking-wide2 text-gold">
                      {item.tag}
                    </span>
                  )}
                  <h3 class="mt-4 font-display text-[1.55rem] leading-tight text-cream">{item.name}</h3>
                </div>
                <p class="shrink-0 font-display text-[1.45rem] text-gold">{item.price}</p>
              </div>
              <p class="mt-3.5 text-sm leading-relaxed text-cream/68">{item.desc}</p>
              <div class="mt-6 h-px w-full bg-white/10" />
              <div class="mt-5 flex items-center justify-between">
                <span class="text-[0.62rem] uppercase tracking-wide2 text-cream/45">IQD</span>
                <span class="inline-flex items-center gap-2 text-[0.66rem] uppercase tracking-wide2 text-sea transition-transform duration-500 group-hover:translate-x-1.5">
                  Order
                  <span aria-hidden="true">→</span>
                </span>
              </div>

              {item.img && (
                <div class="img-frame pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full opacity-25 transition-all duration-700 group-hover:opacity-60 group-hover:-right-10 group-hover:-top-10">
                  <img src={item.img} alt="" width="320" height="320" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </div>
              )}
            </article>
          ))}
        </div>
      ))
    }

    <!-- ============ CTA STRIP ============ -->
    <div
      class="mt-16 flex flex-col items-start justify-between gap-8 rounded-[2rem] border border-white/12 bg-white/[0.06] p-9 backdrop-blur-md sm:flex-row sm:items-center sm:p-11"
      data-reveal="zoom"
    >
      <div>
        <h3 class="font-display text-[clamp(1.85rem,3.2vw,2.65rem)] leading-tight">
          Tasting menus & private rooftop evenings
        </h3>
        <p class="mt-3 max-w-xl text-cream/70">
          Let our chef compose a five-course Aegean journey for your table — available for groups of 6 or more.
        </p>
      </div>
      <a
        href="#reserve"
        class="btn btn-gold shrink-0 rounded-full px-9 text-[0.76rem] font-semibold uppercase tracking-wide2"
        data-magnetic
      >
        <span>Reserve a Table</span>
      </a>
    </div>
  </div>
</section>

<script>
  /* =========================================================
     MENU TABS — liquid indicator morph + panel transitions
     ========================================================= */
  const tablist = document.getElementById('menuTabs');
  const indicator = document.getElementById('tabIndicator');
  const buttons = Array.from(document.querySelectorAll('[data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));

  function moveIndicator(button) {
    if (!indicator || !tablist) return;
    const listRect = tablist.getBoundingClientRect();
    const btnRect = button.getBoundingClientRect();
    const x = btnRect.left - listRect.left + tablist.scrollLeft;
    indicator.style.width = `${btnRect.width}px`;
    indicator.style.transform = `translate3d(${x}px, 0, 0)`;
  }

  function activate(id, focus = false) {
    buttons.forEach((btn) => {
      const selected = btn.getAttribute('data-tab') === id;
      btn.setAttribute('aria-selected', String(selected));
      if (selected) {
        moveIndicator(btn);
        if (focus) btn.focus();
      }
    });
    panels.forEach((panel) => {
      panel.classList.toggle('is-active', panel.getAttribute('data-panel') === id);
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => activate(btn.getAttribute('data-tab')));
    btn.addEventListener('keydown', (e) => {
      const idx = buttons.indexOf(btn);
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        activate(buttons[(idx + 1) % buttons.length].getAttribute('data-tab'), true);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        activate(buttons[(idx - 1 + buttons.length) % buttons.length].getAttribute('data-tab'), true);
      }
    });
  });

  // Initialise indicator position (after fonts/layout settle)
  const first = buttons[0];
  if (first) {
    requestAnimationFrame(() => moveIndicator(first));
    window.addEventListener('load', () => moveIndicator(first));
    window.addEventListener('resize', () => {
      const active = buttons.find((b) => b.getAttribute('aria-selected') === 'true') || first;
      moveIndicator(active);
    });
  }
</script>