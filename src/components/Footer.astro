	<div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
		
		<div class="flex items-center gap-2">
			<div class="w-8 h-8 rounded-full bg-caldera-white text-aegean-deep font-serif flex items-center justify-center font-bold text-sm">S</div>
			<span class="font-serif text-xl tracking-widest uppercase">Santorini</span>
		</div>

		<p class="font-sans text-xs text-limestone/50 text-center md:text-left">
			&copy; {year} Santorini Restaurant Iraq. All rights reserved. <br class="md:hidden" /> A Few Steps To Greece.
		</p>

		<div class="flex items-center gap-6">
			<a href="https://instagram.com/santoriniiq" target="_blank" rel="noopener noreferrer" class="text-limestone/60 hover:text-gold-accent transition-colors" aria-label="Instagram">
