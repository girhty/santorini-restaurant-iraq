<section id="gallery" class="texture-linen relative overflow-hidden bg-sand py-24 sm:py-28 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <!-- ============ HEADER ============ -->
    <div class="flex flex-col gap-9 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="flex items-center gap-3 text-[0.66rem] uppercase tracking-luxe text-terra" data-reveal>
          <span class="h-px w-12 bg-terra" aria-hidden="true"></span>
          Visual Journal
        </p>
        <h2 class="mt-7 max-w-2xl font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] text-ink" data-reveal="left">
          Moments from
          <span class="block italic text-aegean">our Aegean world.</span>
        </h2>
      </div>

      <!-- Instagram profile badge -->
      <div
        class="flex items-center gap-5 rounded-[1.5rem] border border-ink/10 bg-cream/85 p-5 shadow-soft"
        data-reveal="right"
      >
        <span class="block h-16 w-16 overflow-hidden rounded-full ring-2 ring-aegean/40">
          <img
            src="https://scontent-ams2-1.cdninstagram.com/v/t51.2885-19/454466941_1209286150193886_3565551414674742385_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=106&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=hR7Di7zRRPkQ7kNvwEKtkku&_nc_oc=AdqpYPZMnBt8UjRue5si2WQ4_DDYcrgn9h6WHcEztGgbMIHTy0R0XjGZ1jiNCGx1wdU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_ss=7ca8c&oh=00_AQM3f8ZkHRZnBhLCNtOC48uXexlqWmWfoR4aZM7mO4eThw&oe=6ACB3BC3"
            alt="Santorini Restaurant Instagram profile picture"
            width="128"
            height="128"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </span>
        <div>
          <p class="font-display text-xl text-ink">@santoriniiq</p>
          <p class="mt-1 text-xs text-ink/62">
            <strong class="text-aegean" data-count="41656">41,656</strong> followers · Few Steps To Greece
          </p>
          <a
            href="https://www.instagram.com/santoriniiq/"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2.5 inline-flex min-h-[36px] items-center gap-2 rounded-full bg-aegean px-4 text-[0.62rem] font-semibold uppercase tracking-wide2 text-cream transition-colors duration-500 hover:bg-deepsea"
          >
            Follow
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ============ ASYMMETRIC 3D GRID ============ -->
    <div class="mt-14 grid auto-rows-auto grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        posts.map((post, i) => (
          <figure
            class:list={[
              'gallery-item group relative overflow-hidden rounded-[1.5rem] shadow-soft transition-shadow duration-700 hover:shadow-lift',
              post.span,
            ]}
            data-tilt="6"
            data-reveal={i % 3 === 0 ? 'flip' : i % 3 === 1 ? 'zoom' : 'skew'}
            style={`transition-delay:${(i % 4) * 110}ms`}
            tabindex="0"
          >
            <div class:list={['img-frame w-full', post.ratio]}>
              <img
                src={post.img}
                alt={post.caption}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-deepsea/88 via-deepsea/10 to-transparent opacity-70 transition-opacity duration-700 group-hover:opacity-95" />
            </div>

            <!-- Hover overlay -->
            <figcaption class="gallery-overlay absolute inset-x-0 bottom-0 p-6">
              <p class="font-arabic text-sm leading-relaxed text-cream/95" lang="en">
                {post.caption}
              </p>
              <div class="mt-4 flex items-center gap-5 text-cream/85">
                <span class="inline-flex items-center gap-2 text-xs">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 21s-7.5-4.6-9.3-9A5.2 5.2 0 0 1 12 6.5 5.2 5.2 0 0 1 21.3 12c-1.8 4.4-9.3 9-9.3 9Z" />
                  </svg>
                  {post.likes}
                </span>
                <span class="inline-flex items-center gap-2 text-xs">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H9l-5 4V5a1 1 0 0 1 1-1Z" />
                  </svg>
                  {Math.max(1, Math.round(post.likes / 7))}
                </span>
                <span class="text-[0.62rem] uppercase tracking-wide2 text-gold">@santoriniiq</span>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- ============ FEED CTA ============ -->
    <div class="mt-14 flex flex-col items-center gap-6 text-center" data-reveal="zoom">
      <p class="max-w-xl text-ink/70">
        Follow our daily journey — new dishes, rooftop evenings and golden-hour moments from Al-Harithiya.
      </p>
      <a
        href="https://www.instagram.com/santoriniiq/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary rounded-full px-10 text-[0.76rem] font-semibold uppercase tracking-wide2"
        data-magnetic
      >
        <span>View the Instagram Feed</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>