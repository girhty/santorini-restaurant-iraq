---
const instagramUrl = "https://instagram.com/santoriniiq";
---
<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-aegean-deep/80 backdrop-blur-md border-b border-white/10 px-6 py-4" id="navbar">
	<div class="max-w-7xl mx-auto flex justify-between items-center">
		<!-- Logo -->
		<a href="/" class="flex items-center gap-3 group" aria-label="Santorini Home">
			<div class="w-10 h-10 rounded-full bg-caldera-white flex items-center justify-center text-aegean-deep font-serif text-xl font-bold overflow-hidden group-hover:scale-105 transition-transform">
				S
			</div>
			<span class="font-serif text-2xl tracking-widest text-caldera-white uppercase font-semibold">Santorini</span>
		</a>

		<!-- Desktop Nav -->
		<nav class="hidden md:flex items-center gap-8">
			<a href="#about" class="text-sm font-sans font-medium text-limestone hover:text-gold-accent transition-colors uppercase tracking-widest">Experience</a>
			<a href="#menu" class="text-sm font-sans font-medium text-limestone hover:text-gold-accent transition-colors uppercase tracking-widest">Menu</a>
			<a href="#gallery" class="text-sm font-sans font-medium text-limestone hover:text-gold-accent transition-colors uppercase tracking-widest">Gallery</a>
			<a href="#reviews" class="text-sm font-sans font-medium text-limestone hover:text-gold-accent transition-colors uppercase tracking-widest">Reviews</a>
		</nav>

		<!-- Right Actions -->
		<div class="flex items-center gap-6">
			<a href="tel:+9647760202066" class="hidden lg:block text-sm font-medium text-gold-accent hover:text-white transition-colors font-sans tracking-wide">
				+964 776 020 2066
			</a>
			<div class="h-4 w-[1px] bg-white/20 hidden lg:block"></div>
			<div class="text-xs text-limestone/60 font-sans hidden lg:block">EN / AR</div>
			
			<a href="#reservations" class="relative overflow-hidden bg-terracotta text-white px-6 py-2.5 rounded-full text-sm font-semibold tracking-wide hover:bg-[#a94a28] transition-colors shadow-lg shadow-terracotta/30 gpu-accelerated hover:scale-105 active:scale-95">
				Reserve a Table
			</a>
		</div>
	</div>
</header>

<script>
	// Optional: add background to navbar on scroll
	const navbar = document.getElementById('navbar');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 50) {
			navbar?.classList.add('bg-aegean-deep/95', 'shadow-xl');
			navbar?.classList.remove('bg-aegean-deep/80');
		} else {
			navbar?.classList.remove('bg-aegean-deep/95', 'shadow-xl');
			navbar?.classList.add('bg-aegean-deep/80');
		}
	});
</script>