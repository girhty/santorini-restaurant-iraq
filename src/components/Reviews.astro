---
const reviews = [
  {
    "author_name": "Abdullah Furat",
    "rating": 5,
    "text": "The atmospheres are amazing especially on cold and clear days. The place overlooks some of the most beautiful and spectacular Baghdad’s landmarks. I would recommend a visit."
  },
  {
    "author_name": "Ali Taleb",
    "rating": 4,
    "text": "Great atmosphere at the restaurant, something I haven’t seen in Baghdad before. The menu is very diverse. Nevertheless the food was good and the drinks were up to standard."
  },
  {
    "author_name": "Trouxz",
    "rating": 5,
    "text": "Best experience, nice view and food is really delicious!"
  }
];

const StarIcon = () => (
  `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none" class="text-gold-accent"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`
);
---

<section id="reviews" class="py-24 bg-limestone relative">
	<div class="max-w-7xl mx-auto px-6">
		<div class="text-center mb-16 reveal">
			<h2 class="font-serif text-4xl md:text-5xl text-aegean-deep mb-4">Guest Testimonials</h2>
			<div class="flex justify-center items-center gap-2">
				<div class="flex text-gold-accent">
					<Fragment set:html={StarIcon()} />
					<Fragment set:html={StarIcon()} />
					<Fragment set:html={StarIcon()} />
					<Fragment set:html={StarIcon()} />
					<Fragment set:html={StarIcon()} />
				</div>
				<span class="font-sans text-aegean-deep font-medium ml-2">4.5 out of 5 on Google Reviews</span>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 staggered-reveal">
			{reviews.map((review) => (
				<div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100 tilt-card gpu-accelerated">
					<div class="flex gap-1 mb-4">
						{Array(review.rating).fill(0).map(() => (
							<Fragment set:html={StarIcon()} />
						))}
					</div>
					<p class="font-sans text-aegean-deep/80 text-sm leading-relaxed mb-6 line-clamp-5">
						"{review.text}"
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<div class="w-10 h-10 rounded-full bg-aegean-blue text-white flex items-center justify-center font-serif font-bold">
							{review.author_name.charAt(0)}
						</div>
						<span class="font-sans font-semibold text-aegean-deep text-sm">{review.author_name}</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>