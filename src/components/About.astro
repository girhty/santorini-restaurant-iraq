<section id="about" class="py-24 md:py-32 bg-caldera-white relative overflow-hidden">
	<!-- Decorative stone background element -->
	<div class="absolute top-0 right-0 w-96 h-96 bg-limestone/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>

	<div class="max-w-7xl mx-auto px-6 relative z-10">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
			
			<!-- Text Content -->
			<div class="reveal order-2 lg:order-1 flex flex-col justify-center">
				<div class="flex items-center gap-3 mb-4">
					<div class="h-[1px] w-12 bg-terracotta"></div>
					<span class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-terracotta">The Experience</span>
				</div>
				
				<h2 class="font-serif text-4xl md:text-5xl lg:text-6xl text-aegean-deep leading-[1.1] mb-6">
					Cycladic Elegance in the Heart of Baghdad
				</h2>
				
				<p class="font-sans text-lg text-aegean-deep/80 mb-6 leading-relaxed">
					Santorini brings the breathtaking charm of the Aegean to Al-Harithiya. Designed with whitewashed arches and textured stone, our rooftop provides a dramatic backdrop overlooking the most spectacular landmarks of Baghdad's skyline.
				</p>
				
				<p class="font-sans text-lg text-aegean-deep/80 mb-10 leading-relaxed">
					Experience the golden hour while savoring authentic Greek flavors—from our charcoal grill seafood to crisp Santorini salads, paired perfectly with our curated wine list.
				</p>

				<!-- Bilingual snippet -->
				<div class="p-6 border-l-2 border-gold-accent bg-white shadow-xl rounded-r-2xl mb-10" dir="rtl">
					<p class="font-sans text-aegean-deep/80 italic">
						"في سانتوريني، تفاصيل تنبض بالجمال؛ موسيقى آسرة، أجواء راقية، وأطباق شهية تُقدَّم بذوق يليق بتجربة استثنائية"
					</p>
				</div>
				
				<a href="#reservations" class="inline-flex items-center gap-2 text-aegean-blue font-sans font-semibold uppercase tracking-widest hover:text-terracotta transition-colors w-fit group">
					Book Your Escape
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
				</a>
			</div>

			<!-- Asymmetric Image Grid with 3D Tilts -->
			<div class="order-1 lg:order-2 grid grid-cols-2 gap-4 md:gap-6 relative reveal">
				<div class="mt-12 space-y-4 md:space-y-6">
					<div class="tilt-card gpu-accelerated rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] relative group">
						<img src={images[0]} alt="Cycladic archway" class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700" />
						<div class="absolute inset-0 bg-gradient-to-t from-aegean-deep/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					</div>
					<div class="tilt-card gpu-accelerated rounded-2xl overflow-hidden shadow-xl aspect-square relative group">
						<img src={images[1]} alt="Authentic Greek Seafood" class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700" />
					</div>
				</div>
				<div class="space-y-4 md:space-y-6">
					<div class="tilt-card gpu-accelerated rounded-2xl overflow-hidden shadow-xl aspect-square relative group">
						<img src={images[2]} alt="Linen table setup" class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700" />
					</div>
					<div class="tilt-card gpu-accelerated rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] relative group p-8 flex flex-col justify-end bg-aegean-blue text-white">
						<div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/white-wall.png')] mix-blend-overlay"></div>
						<h3 class="font-serif text-3xl mb-2 relative z-10">Rooftop Vibes</h3>
						<p class="font-sans text-sm text-white/80 relative z-10">Experience twilight dining like never before.</p>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>