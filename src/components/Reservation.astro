---
/**
 * ==============================================================
 *  RESERVATIONS & CONTACT
 *  Interactive reservation form with date/time/party chips,
 *  contact cards, opening hours and styled map.
 * ==============================================================
 */

const timeSlots = ['12:30', '14:00', '16:30', '18:30', '20:00', '21:30', '23:00'];
const guestOptions = ['1', '2', '3', '4', '5', '6', '8', '10+'];

const days = [
  { label: 'Today', date: 'Fri' },
  { label: 'Sat', date: '12' },
  { label: 'Sun', date: '13' },
  { label: 'Mon', date: '14' },
  { label: 'Tue', date: '15' },
  { label: 'Wed', date: '16' },
  { label: 'Thu', date: '17' },
];

const contactCards = [
  {
    title: 'Location',
    lines: ['894G+JJX, شارع الزيتون', 'Al-Harithiya, Baghdad Governorate'],
    action: 'Get directions',
    href: 'https://maps.google.com/?q=Al-Harithiya+Zeitoun+Street+Baghdad',
    icon: 'pin',
  },
  {
    title: 'Reservations',
    lines: ['+964 776 020 2066', 'hello@santorini-restaurant-iraq.com'],
    action: 'Call now',
    href: 'tel:+9647760202066',
    icon: 'phone',
  },
  {
    title: 'Opening Hours',
    lines: ['Sun — Thu · 12:00 → 01:00', 'Fri — Sat · 12:00 → 02:00'],
    action: 'Open now',
    href: '#reserve',
    icon: 'clock',
  },
];
---

<section id="reserve" class="relative overflow-hidden bg-deepsea py-24 text-cream sm:py-28 lg:py-32">
  <!-- Sculptural background -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute left-[4%] top-[8%] h-[28rem] w-[28rem] rounded-full border border-white/8"></div>
    <div class="absolute bottom-[-8rem] right-[6%] h-[30rem] w-[30rem] rounded-t-full border border-gold/12"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_78%_18%,rgba(217,164,65,0.20),transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_12%_88%,rgba(46,134,171,0.24),transparent_58%)]"></div>
  </div>

  <div class="relative mx-auto max-w-[1400px] px-5 sm:px-8">
    <!-- ============ HEADER ============ -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="flex items-center gap-3 text-[0.66rem] uppercase tracking-luxe text-gold" data-reveal>
          <span class="h-px w-12 bg-gold" aria-hidden="true"></span>
          Reservations & Contact
        </p>
        <h2 class="mt-7 max-w-3xl font-display text-[clamp(2.5rem,6.1vw,5.1rem)] leading-[0.95]" data-reveal="left">
          Your table
          <span class="block italic text-gold">is waiting.</span>
        </h2>
      </div>
      <p class="max-w-md text-cream/72 leading-relaxed" data-reveal="right">
        We recommend booking ahead for weekend rooftop evenings. Our team will confirm your reservation within a few
        minutes by phone or WhatsApp.
      </p>
    </div>

    <!-- ============ RESERVATION FORM ============ -->
    <div class="mt-14 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <!-- Form card -->
      <form
        class="rounded-[2rem] border border-white/12 bg-white/[0.07] p-8 backdrop-blur-xl sm:p-11"
        id="reservationForm"
        novalidate
        data-reveal="flip"
      >
        <h3 class="font-display text-[1.95rem] leading-tight text-cream">Book your Santorini experience</h3>
        <p class="mt-2.5 text-sm text-cream/65">All fields marked with * are required.</p>

        <!-- Date chips -->
        <fieldset class="mt-9">
          <legend class="text-[0.62rem] uppercase tracking-luxe text-gold">Select a day</legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              days.map((day, i) => (
                <button
                  type="button"
                  class="chip flex min-w-[4.6rem] flex-col items-center gap-1 rounded-2xl border border-white/15 px-4 py-3 text-cream/80"
                  data-chip="day"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  <span class="text-[0.58rem] uppercase tracking-wide2">{day.label}</span>
                  <span class="font-display text-lg leading-none">{day.date}</span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <!-- Time chips -->
        <fieldset class="mt-8">
          <legend class="text-[0.62rem] uppercase tracking-luxe text-gold">Select a time</legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              timeSlots.map((slot, i) => (
                <button
                  type="button"
                  class="chip rounded-full border border-white/15 px-5 py-2.5 text-sm text-cream/80"
                  data-chip="time"
                  aria-pressed={i === 4 ? 'true' : 'false'}
                >
                  {slot}
                </button>
              ))
            }
          </div>
        </fieldset>

        <!-- Guests chips -->
        <fieldset class="mt-8">
          <legend class="text-[0.62rem] uppercase tracking-luxe text-gold">Guests</legend>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              guestOptions.map((guest, i) => (
                <button
                  type="button"
                  class="chip rounded-full border border-white/15 px-5 py-2.5 text-sm text-cream/80"
                  data-chip="guests"
                  aria-pressed={i === 1 ? 'true' : 'false'}
                >
                  {guest}
                </button>
              ))
            }
          </div>
        </fieldset>

        <!-- Details -->
        <div class="mt-9 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="guestName" class="mb-2.5 block text-[0.62rem] uppercase tracking-luxe text-cream/70">
              Full name *
            </label>
            <input id="guestName" name="name" type="text" required placeholder="Your name" class="field text-ink" />
          </div>
          <div>
            <label for="guestPhone" class="mb-2.5 block text-[0.62rem] uppercase tracking-luxe text-cream/70">
              Phone number *
            </label>
            <input id="guestPhone" name="phone" type="tel" required placeholder="+964 ..." class="field text-ink" />
          </div>
          <div>
            <label for="guestEmail" class="mb-2.5 block text-[0.62rem] uppercase tracking-luxe text-cream/70">
              Email
            </label>
            <input id="guestEmail" name="email" type="email" placeholder="you@email.com" class="field text-ink" />
          </div>
          <div>
            <label for="occasion" class="mb-2.5 block text-[0.62rem] uppercase tracking-luxe text-cream/70">
              Occasion
            </label>
            <select id="occasion" name="occasion" class="field text-ink">
              <option>Dinner</option>
              <option>Birthday</option>
              <option>Anniversary</option>
              <option>Business dinner</option>
              <option>Private rooftop event</option>
            </select>
          </div>
        </div>

        <div class="mt-7">
          <label for="notes" class="mb-2.5 block text-[0.62rem] uppercase tracking-luxe text-cream/70">
            Special requests
          </label>
          <textarea
            id="notes"
            name="notes"
            rows="4"
            placeholder="Window table, dietary requirements, celebration details…"
            class="field resize-none text-ink"></textarea>
        </div>

        <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
          <button
            type="submit"
            class="btn btn-gold w-full rounded-full px-10 text-[0.76rem] font-semibold uppercase tracking-wide2 sm:w-auto"
            data-magnetic
          >
            <span>Confirm Reservation</span>
          </button>
          <p class="text-xs text-cream/55">
            Or call us directly on
            <a href="tel:+9647760202066" class="text-gold underline-offset-4 hover:underline">+964 776 020 2066</a>
          </p>
        </div>

        <!-- Success state -->
        <div
          id="reservationSuccess"
          class="mt-8 hidden items-start gap-4 rounded-2xl border border-gold/35 bg-gold/12 p-6"
          role="status"
          aria-live="polite"
        >
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gold text-deepsea">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12.5 10 17l9-10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <div>
            <p class="font-display text-xl text-cream">Efharistó! Your request has been received.</p>
            <p class="mt-1.5 text-sm text-cream/72">
              Our team will call you shortly to confirm your table at Santorini.
            </p>
          </div>
        </div>
      </form>

      <!-- Side: map + hours -->
      <div class="flex flex-col gap-7">
        <!-- Map card -->
        <div class="overflow-hidden rounded-[2rem] border border-white/12 shadow-lift" data-reveal="right">
          <div class="relative">
            <iframe
              title="Map showing Santorini Restaurant location in Al-Harithiya, Baghdad"
              src="https://www.openstreetmap.org/export/embed.html?bbox=44.3625%2C33.3025%2C44.4145%2C33.3425&layer=mapnik&marker=33.3225%2C44.3885"
              class="h-[19rem] w-full border-0 saturate-[0.72] contrast-[1.06]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-deepsea/72 via-transparent to-transparent">
            </div>
            <div class="absolute bottom-5 left-5 right-5 glass-dark rounded-2xl p-5">
              <p class="text-[0.62rem] uppercase tracking-luxe text-gold">Find us</p>
              <p class="mt-2 text-sm text-cream/88">894G+JJX, شارع الزيتون — Al-Harithiya, Baghdad</p>
              <a
                href="https://maps.google.com/?q=Al-Harithiya+Zeitoun+Street+Baghdad"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex min-h-[40px] items-center gap-2 rounded-full bg-cream px-5 text-[0.65rem] font-semibold uppercase tracking-wide2 text-ink transition-transform duration-500 hover:-translate-y-0.5"
              >
                Open in Maps
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Contact cards -->
        <div class="grid gap-5">
          {
            contactCards.map((card, i) => (
              <div
                class="group rounded-[1.5rem] border border-white/12 bg-white/[0.06] p-6 transition-all duration-700 hover:-translate-y-1.5 hover:border-gold/40 hover:bg-white/[0.1]"
                data-tilt="5"
                data-reveal="right"
                style={`transition-delay:${i * 120}ms`}
              >
                <div class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold/18 text-gold">
                    {card.icon === 'pin' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7Zm0 9.5A2.5 2.5 0 1 0 12 6.5a2.5 2.5 0 0 0 0 5Z" />
                      </svg>
                    )}
                    {card.icon === 'phone' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z" />
                      </svg>
                    )}
                    {card.icon === 'clock' && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
                        <path d="M12 7v5.2l3.2 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      </svg>
                    )}
                  </span>
                  <div class="flex-1">
                    <h3 class="font-display text-xl text-cream">{card.title}</h3>
                    {card.lines.map((line) => (
                      <p class="mt-1.5 text-sm text-cream/72">{line}</p>
                    ))}
                    <a
                      href={card.href}
                      target={card.href.startsWith('http') ? '_blank' : undefined}
                      rel={card.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="mt-3.5 inline-flex items-center gap-2 text-[0.65rem] font-semibold uppercase tracking-wide2 text-gold transition-transform duration-500 group-hover:translate-x-1.5"
                    >
                      {card.action}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- ============ CLOSING BANNER ============ -->
    <div
      class="mt-20 flex flex-col items-center gap-7 rounded-[2.25rem] border border-white/12 bg-white/[0.06] px-8 py-14 text-center backdrop-blur-md"
      data-reveal="zoom"
    >
      <p class="text-[0.62rem] uppercase tracking-luxe text-gold">Few steps to Greece</p>
      <h3 class="max-w-3xl font-display text-[clamp(2.15rem,4.6vw,3.75rem)] leading-[1.02]">
        Live the details of Santorini —
        <span class="italic text-gold">with every bite.</span>
      </h3>
      <p class="max-w-xl text-cream/72">
        Al-Harithiya · Zeitoun Street · Baghdad — the rooftop everyone is talking about.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="tel:+9647760202066"
          class="btn btn-primary rounded-full px-9 text-[0.76rem] font-semibold uppercase tracking-wide2"
          data-magnetic
        >
          <span>Call +964 776 020 2066</span>
        </a>
        <a
          href="https://www.instagram.com/santoriniiq/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost rounded-full px-9 text-[0.76rem] font-semibold uppercase tracking-wide2"
          data-magnetic
        >
          <span>@santoriniiq</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  /* =========================================================
     RESERVATION FORM — chip selectors + success state
     ========================================================= */
  const chipGroups = ['day', 'time', 'guests'];

  chipGroups.forEach((group) => {
    const chips = Array.from(document.querySelectorAll(`[data-chip="${group}"]`));
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
        chip.setAttribute('aria-pressed', 'true');
      });
    });
  });

  const form = document.getElementById('reservationForm');
  const success = document.getElementById('reservationSuccess');

  if (form && success) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const nameInput = document.getElementById('guestName');
      const phoneInput = document.getElementById('guestPhone');

      if (nameInput instanceof HTMLInputElement && !nameInput.value.trim()) {
        nameInput.focus();
        nameInput.style.borderColor = '#C0703F';
        return;
      }
      if (phoneInput instanceof HTMLInputElement && !phoneInput.value.trim()) {
        phoneInput.focus();
        phoneInput.style.borderColor = '#C0703F';
        return;
      }

      success.classList.remove('hidden');
      success.classList.add('flex');
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>