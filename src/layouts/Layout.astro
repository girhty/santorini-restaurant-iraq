---
/**
 * ==============================================================
 *  LAYOUT — global shell for Santorini Restaurant (Baghdad)
 *  Contains: head + SEO + JSON-LD, sticky glass header, mobile
 *  navigation, footer, global scroll-driven animation pipelines.
 * ==============================================================
 */

const {
  title = 'Santorini Restaurant — A Few Steps to Greece | Baghdad, Iraq',
  description = 'Santorini Restaurant in Al-Harithiya, Baghdad — authentic Greek-Mediterranean cuisine, rooftop views over the city, curated wines and an unforgettable Aegean atmosphere. Reserve your table today.',
} = Astro.props;

const profilePic =
  'https://scontent-ams2-1.cdninstagram.com/v/t51.2885-19/454466941_1209286150193886_3565551414674742385_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=106&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=hR7Di7zRRPkQ7kNvwEKtkku&_nc_oc=AdqpYPZMnBt8UjRue5si2WQ4_DDYcrgn9h6WHcEztGgbMIHTy0R0XjGZ1jiNCGx1wdU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_ss=7ca8c&oh=00_AQM3f8ZkHRZnBhLCNtOC48uXexlqWmWfoR4aZM7mO4eThw&oe=6ACB3BC3';

const navLinks = [
  { href: '#experience', label: 'The Experience' },
  { href: '#menu', label: 'Menu' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#reserve', label: 'Contact' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Santorini Restaurant',
  alternateName: 'مطعم سانتوريني',
  image: profilePic,
  url: 'https://santorini-restaurant-iraq.com/',
  telephone: '+9647760202066',
  priceRange: '$$$',
  servesCuisine: ['Greek', 'Mediterranean', 'Seafood'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'شارع الزيتون, Al-Harithiya',
    addressLocality: 'Baghdad',
    addressRegion: 'Baghdad Governorate',
    addressCountry: 'IQ',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 33.3225, longitude: 44.3885 },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '188',
    bestRating: '5',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '12:00',
      closes: '01:00',
    },
  ],
  sameAs: ['https://www.instagram.com/santoriniiq/'],
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08304B" />
    <meta name="author" content="Santorini Restaurant — Baghdad" />
    <link rel="canonical" href="https://santorini-restaurant-iraq.com/" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={profilePic} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profilePic} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Typography: Cormorant Garamond (display) + Jost (UI) + Noto Kufi Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&family=Jost:wght@200;300;400;500;600&family=Noto+Kufi+Arabic:wght@300;400;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- ================= GLOBAL DESIGN TOKENS ================= -->
    <style is:global>
      :root {
        /* --- Palette injected from the Santorini Instagram brand --- */
        --c-deepsea: #08304b;
        --c-aegean: #12557e;
        --c-sea: #2e86ab;
        --c-sky: #8fc1de;
        --c-ink: #0a2540;
        --c-sand: #f4ede2;
        --c-cream: #fffaf2;
        --c-terra: #c0703f;
        --c-gold: #d9a441;
        --c-olive: #6e7b5b;

        /* --- Transform anchors (used by scroll/tilt pipelines) --- */
        --tilt-rx: 0deg;
        --tilt-ry: 0deg;
        --tilt-tz: 0px;
        --parallax-y: 0px;

        /* --- Motion curves --- */
        --ease-luxe: cubic-bezier(0.16, 1, 0.3, 1);
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        background-color: var(--c-sand);
        color: var(--c-ink);
        overflow-x: hidden;
      }

      ::selection {
        background: var(--c-aegean);
        color: var(--c-cream);
      }

      /* Focus visibility (accessibility) */
      :focus-visible {
        outline: 2px solid var(--c-gold);
        outline-offset: 3px;
        border-radius: 4px;
      }

      section[id] {
        scroll-margin-top: 96px;
      }

      /* =========================================================
         SCROLL-BOUND REVEAL PIPELINE
         Each [data-reveal] variant animates on viewport entry with
         GPU-only properties (transform / opacity / clip-path).
         ========================================================= */
      [data-reveal] {
        opacity: 0;
        transform: translate3d(0, 32px, 0);
        transition:
          opacity 0.95s var(--ease-luxe),
          transform 1.05s var(--ease-luxe),
          clip-path 1.1s var(--ease-luxe);
        will-change: transform, opacity;
      }
      [data-reveal='left'] {
        transform: translate3d(-48px, 12px, 0) rotate(-1.6deg);
      }
      [data-reveal='right'] {
        transform: translate3d(48px, 12px, 0) rotate(1.6deg);
      }
      [data-reveal='flip'] {
        transform: perspective(1300px) rotateX(16deg) rotateY(-12deg) translateY(64px) scale3d(0.92, 0.92, 1);
      }
      [data-reveal='zoom'] {
        transform: scale3d(0.88, 0.88, 1);
      }
      [data-reveal='skew'] {
        transform: skewY(3deg) translate3d(0, 40px, 0);
      }
      [data-reveal='mask'] {
        opacity: 1;
        transform: none;
        clip-path: inset(0 100% 0 0);
      }
      [data-reveal].is-visible {
        opacity: 1;
        transform: none;
      }
      [data-reveal='mask'].is-visible {
        clip-path: inset(0 0 0 0);
      }

      /* =========================================================
         3D TILT MICRO-INTERACTION (hover / pointer driven)
         ========================================================= */
      [data-tilt] {
        transform: perspective(1000px) rotateX(var(--tilt-rx)) rotateY(var(--tilt-ry)) translateZ(var(--tilt-tz));
        transition: transform 0.6s var(--ease-luxe), box-shadow 0.6s var(--ease-luxe);
        transform-style: preserve-3d;
        will-change: transform;
      }

      /* Parallax layers */
      [data-parallax] {
        will-change: transform;
        transform: translate3d(0, var(--parallax-y), 0);
      }

      /* Sticky/pinned sculptural blocks */
      .pin-block {
        position: sticky;
        top: 6.5rem;
      }

      /* Glass / liquid surfaces */
      .glass {
        background: rgba(255, 250, 242, 0.08);
        backdrop-filter: blur(18px) saturate(140%);
        -webkit-backdrop-filter: blur(18px) saturate(140%);
        border: 1px solid rgba(255, 250, 242, 0.18);
      }
      .glass-dark {
        background: rgba(8, 48, 75, 0.55);
        backdrop-filter: blur(20px) saturate(150%);
        -webkit-backdrop-filter: blur(20px) saturate(150%);
        border: 1px solid rgba(255, 250, 242, 0.12);
      }

      /* Linen / stone texture overlays */
      .texture-linen {
        background-image:
          radial-gradient(circle at 15% 12%, rgba(217, 164, 65, 0.12), transparent 42%),
          radial-gradient(circle at 85% 88%, rgba(46, 134, 171, 0.12), transparent 46%),
          repeating-linear-gradient(45deg, rgba(10, 37, 64, 0.025) 0 2px, transparent 2px 6px);
      }
      .texture-stone {
        background-image:
          linear-gradient(180deg, rgba(8, 48, 75, 0.92), rgba(18, 85, 126, 0.86)),
          repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 9px);
      }

      /* Blur-up image placeholders */
      .img-frame {
        position: relative;
        overflow: hidden;
        background:
          linear-gradient(115deg, rgba(18, 85, 126, 0.35), rgba(217, 164, 65, 0.25)),
          var(--c-sand);
      }
      .img-frame img {
        transition: transform 1.1s var(--ease-luxe), opacity 0.8s ease, filter 0.8s ease;
      }
      .img-frame:hover img {
        transform: scale3d(1.07, 1.07, 1);
        filter: saturate(112%);
      }

      /* Masked image reveal (clip-path morph) */
      .clip-arch {
        clip-path: inset(0 round 240px 240px 18px 18px);
      }

      /* Scroll progress bar */
      .scroll-progress {
        position: fixed;
        inset: 0 auto auto 0;
        height: 3px;
        width: 0%;
        z-index: 90;
        background: linear-gradient(90deg, var(--c-gold), var(--c-sea), var(--c-aegean));
        transition: width 0.12s linear;
      }

      /* Header state */
      .site-header {
        transition: transform 0.55s var(--ease-luxe), background-color 0.5s ease, box-shadow 0.5s ease,
          border-color 0.5s ease, padding 0.45s ease;
      }
      .site-header.is-scrolled {
        background-color: rgba(255, 250, 242, 0.9);
        box-shadow: 0 22px 60px -38px rgba(8, 48, 75, 0.55);
        border-color: rgba(10, 37, 64, 0.09);
      }
      .site-header.is-hidden {
        transform: translate3d(0, -108%, 0);
      }
      .site-header.is-scrolled .nav-link {
        color: var(--c-ink);
      }
      .site-header.is-scrolled .brand-wordmark {
        color: var(--c-ink);
      }
      .site-header.is-scrolled .brand-sub {
        color: rgba(10, 37, 64, 0.62);
      }

      .nav-link {
        position: relative;
        color: rgba(255, 250, 242, 0.88);
      }
      .nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -7px;
        height: 1.5px;
        width: 100%;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: right center;
        transition: transform 0.5s var(--ease-luxe);
      }
      .nav-link:hover::after,
      .nav-link:focus-visible::after {
        transform: scaleX(1);
        transform-origin: left center;
      }

      /* Buttons — liquid / glass hover */
      .btn {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        min-height: 52px;
        min-width: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        transition: transform 0.5s var(--ease-luxe), box-shadow 0.5s var(--ease-luxe), color 0.4s ease,
          background-color 0.45s ease, border-color 0.45s ease;
        will-change: transform;
      }
      .btn > span {
        position: relative;
        z-index: 2;
      }
      .btn::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(120deg, transparent 15%, rgba(255, 255, 255, 0.35), transparent 85%);
        transform: translate3d(-120%, 0, 0);
        transition: transform 0.75s var(--ease-luxe);
      }
      .btn:hover::before,
      .btn:focus-visible::before {
        transform: translate3d(120%, 0, 0);
      }
      .btn-primary {
        background: linear-gradient(135deg, var(--c-aegean), var(--c-sea));
        color: var(--c-cream);
        box-shadow: 0 26px 60px -26px rgba(18, 85, 126, 0.75);
      }
      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 34px 80px -28px rgba(18, 85, 126, 0.85);
      }
      .btn-gold {
        background: linear-gradient(135deg, var(--c-gold), var(--c-terra));
        color: #2b1405;
        box-shadow: 0 26px 60px -26px rgba(217, 164, 65, 0.7);
      }
      .btn-gold:hover {
        transform: translateY(-3px);
      }
      .btn-ghost {
        border: 1px solid rgba(255, 250, 242, 0.5);
        color: var(--c-cream);
      }
      .btn-ghost:hover {
        background: rgba(255, 250, 242, 0.14);
        border-color: rgba(255, 250, 242, 0.9);
        transform: translateY(-3px);
      }

      /* Marquee band */
      .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee 38s linear infinite;
      }

      /* Menu tab indicator (liquid morph) */
      .tab-indicator {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--c-aegean), var(--c-sea));
        box-shadow: 0 22px 46px -20px rgba(18, 85, 126, 0.8);
        transition: transform 0.6s var(--ease-luxe), width 0.6s var(--ease-luxe);
        will-change: transform, width;
        z-index: 0;
      }
      .tab-btn {
        position: relative;
        z-index: 1;
        transition: color 0.45s ease, transform 0.45s var(--ease-luxe);
        min-height: 48px;
      }
      .tab-btn[aria-selected='true'] {
        color: var(--c-cream);
      }

      /* Menu panels */
      .menu-panel {
        display: none;
      }
      .menu-panel.is-active {
        display: grid;
        animation: panelIn 0.7s var(--ease-luxe) both;
      }
      @keyframes panelIn {
        from {
          opacity: 0;
          transform: perspective(1200px) rotateX(7deg) translateY(26px) scale3d(0.985, 0.985, 1);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      /* Gallery hover overlay */
      .gallery-item .gallery-overlay {
        opacity: 0;
        transform: translate3d(0, 16px, 0);
        transition: opacity 0.55s var(--ease-luxe), transform 0.55s var(--ease-luxe);
      }
      .gallery-item:hover .gallery-overlay,
      .gallery-item:focus-visible .gallery-overlay {
        opacity: 1;
        transform: none;
      }
      .gallery-item:hover img {
        transform: scale3d(1.09, 1.09, 1);
      }

      /* Reservation chips */
      .chip {
        position: relative;
        min-height: 46px;
        min-width: 46px;
        transition: transform 0.4s var(--ease-luxe), background-color 0.35s ease, color 0.35s ease,
          border-color 0.35s ease, box-shadow 0.35s ease;
      }
      .chip:hover {
        transform: translateY(-2px);
      }
      .chip[aria-pressed='true'] {
        background: linear-gradient(135deg, var(--c-aegean), var(--c-sea));
        color: var(--c-cream);
        border-color: transparent;
        box-shadow: 0 18px 38px -18px rgba(18, 85, 126, 0.8);
      }

      /* Form fields */
      .field {
        width: 100%;
        min-height: 54px;
        border-radius: 14px;
        border: 1px solid rgba(10, 37, 64, 0.16);
        background: rgba(255, 250, 242, 0.75);
        padding: 0.85rem 1.1rem;
        transition: border-color 0.35s ease, box-shadow 0.35s ease, background-color 0.35s ease;
      }
      .field:focus {
        outline: none;
        border-color: var(--c-sea);
        background: var(--c-cream);
        box-shadow: 0 0 0 4px rgba(46, 134, 171, 0.16);
      }

      /* Decorative arches / drifting rings */
      .drift-ring {
        animation: floaty 9s ease-in-out infinite;
      }

      /* Reduced motion — respect user preference */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
        }
      }
    </style>
  </head>

  <body class="font-sans antialiased">
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

    <!-- ========================= HEADER ========================= -->
    <header class="site-header fixed inset-x-0 top-0 z-50 border-b border-white/10 py-4 md:py-6" id="siteHeader">
      <nav class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-5 sm:px-8" aria-label="Primary">
        <!-- Brand mark: derived from the Santorini Instagram profile image -->
        <a href="#home" class="group flex items-center gap-3" aria-label="Santorini Restaurant — home">
          <span class="relative block h-12 w-12 overflow-hidden rounded-full ring-2 ring-gold/70 shadow-soft">
            <img
              src={profilePic}
              alt="Santorini Restaurant logo"
              width="96"
              height="96"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
          </span>
          <span class="leading-none">
            <span
              class="brand-wordmark block font-display text-[1.35rem] font-600 tracking-[0.18em] text-cream transition-colors duration-500"
            >
              SANTORINI
            </span>
            <span class="brand-sub block text-[0.62rem] uppercase tracking-luxe text-cream/70 transition-colors duration-500">
              Baghdad · Greece
            </span>
          </span>
        </a>

        <!-- Desktop links -->
        <ul class="hidden items-center gap-9 lg:flex">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="nav-link text-[0.78rem] font-medium uppercase tracking-wide2 transition-colors duration-300 hover:text-gold"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="flex items-center gap-3">
          <a
            href="tel:+9647760202066"
            class="hidden items-center gap-2 rounded-full border border-white/25 px-4 py-2.5 text-[0.72rem] uppercase tracking-wide2 text-cream/90 transition-all duration-500 hover:border-gold hover:text-gold md:inline-flex"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
                fill="currentColor"></path>
            </svg>
            +964 776 020 2066
          </a>
          <a href="#reserve" class="btn btn-gold rounded-full px-6 text-[0.74rem] font-semibold uppercase tracking-wide2">
            <span>Reserve</span>
          </a>
          <button
            type="button"
            id="menuToggle"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-cream lg:hidden"
            aria-expanded="false"
            aria-controls="mobileMenu"
            aria-label="Open navigation menu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobileMenu"
        class="mt-4 hidden overflow-hidden rounded-3xl border border-ink/10 bg-cream/95 shadow-lift lg:hidden"
      >
        <ul class="flex flex-col divide-y divide-ink/10">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="mobile-link flex min-h-[56px] items-center justify-between px-6 text-sm uppercase tracking-wide2 text-ink"
                >
                  {link.label}
                  <span aria-hidden="true" class="text-sea">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- ========================= FOOTER ========================= -->
    <footer class="relative overflow-hidden bg-deepsea text-cream">
      <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full border border-white/10" aria-hidden="true">
      </div>
      <div class="pointer-events-none absolute -left-32 bottom-0 h-96 w-96 rounded-full border border-gold/15" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:py-24">
        <div class="grid gap-14 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
          <div>
            <div class="flex items-center gap-4">
              <span class="block h-16 w-16 overflow-hidden rounded-full ring-2 ring-gold/60">
                <img src={profilePic} alt="Santorini Restaurant emblem" width="128" height="128" class="h-full w-full object-cover" loading="lazy" />
              </span>
              <div>
                <p class="font-display text-2xl tracking-[0.2em]">SANTORINI</p>
                <p class="text-[0.65rem] uppercase tracking-luxe text-cream/60">Few steps to Greece</p>
              </div>
            </div>
            <p class="mt-7 max-w-sm text-cream/70 leading-relaxed">
              Sun-drenched Mediterranean plates, slow Aegean evenings and the most cinematic rooftop skyline in Baghdad.
              <span class="mt-3 block font-arabic text-cream/80" dir="rtl" lang="ar">
                خطوات قليلة لتشعر أنك في اليونان.
              </span>
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a
                href="https://www.instagram.com/santoriniiq/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-white/15 px-5 text-xs uppercase tracking-wide2 transition-all duration-500 hover:border-gold hover:text-gold"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path
